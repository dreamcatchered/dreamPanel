# Admin Bot + Flask Panel (manage.dreampartners.online)
#
# Как использовать:
# - В systemd: положи копию в /etc/admin_bot.env (см. EnvironmentFile в admin-bot.service)
# - Локально: можно скопировать в projects/admin_bot/.env (run.py умеет подхватывать)

# ===================== TELEGRAM =====================
# ТОКЕН БОТА (нужен для Telegram Bot + проверки Telegram WebApp initData)
TELEGRAM_BOT_TOKEN=your_bot_token_here
# совместимость (bot.py также читает BOT_TOKEN)
BOT_TOKEN=your_bot_token_here

# Админ Telegram ID (для веб-панели)
ADMIN_TELEGRAM_ID=123456789
# Список админов для бота (через запятую)
ADMIN_IDS=123456789

# ===================== WEB PANEL =====================
# Порт Flask панели
PORT=5001

# Секрет Flask (для сессий). Можно оставить как есть, но лучше поменять.
SECRET_KEY=change_me_super_secret_key_please_64

# Логин/пароль для входа через форму (если не через Telegram WebApp)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_please
# Если укажешь ADMIN_PASSWORD_HASH, то ADMIN_PASSWORD игнорируется
# ADMIN_PASSWORD_HASH=

# ===================== FILE MANAGER =====================
# Лимит размера файла для встроенного редактора (в байтах)
MAX_EDITOR_BYTES=2097152

# Разрешить ПРОСМОТР всего сервера (/) в файловом менеджере (read-only вне разрешённых write-root'ов)
FILE_MANAGER_ALLOW_READ_ALL=1

# ===================== SSL / CERTBOT =====================
# Email по умолчанию для certbot (если в форме пусто). Можно оставить пустым.
CERTBOT_DEFAULT_EMAIL=

# ===================== ALERTS (BOT MONITORING) =====================
# Включить тревоги от бота
ALERT_ENABLED=1
# Как часто проверять (сек)
ALERT_INTERVAL_SEC=30
# Анти-спам: не чаще чем раз в N секунд для одного типа тревоги/сервиса
ALERT_COOLDOWN_SEC=600
# Тревога, если RAM используется больше/равно %
ALERT_MEMORY_PERCENT=90
# Тревога, если один сервис (MainPID) жрёт больше/равно MB RSS
ALERT_SERVICE_RSS_MB=1024
# Сколько сервисов показывать в топе
ALERT_TOP_N=5

# ===================== BACKUPS =====================
# Где хранить бэкапы панели
BACKUPS_DIR=/home/YOUR_USER/backups/panel

# ===================== PROJECTS / BOTS DIRS =====================
# Каталог проектов и ботов (по умолчанию ~/projects и ~/bots)
#PROJECTS_DIR=/home/YOUR_USER/projects
#BOTS_DIR=/home/YOUR_USER/bots

# ===================== DREAM API DATA =====================
# Путь к папке data/ с files projects.json, status.json, tariffs.json
# Используется для управления каталогом проектов через панель (вкладка Микросервисы)
DREAM_API_DATA_DIR=/home/YOUR_USER/projects/api/data

# ===================== CLOUDFLARE =====================
# API-токен Cloudflare (для управления DNS через панель)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
